# ============================================
# SafarSutra — Root GitIgnore (Security & Build)
# ============================================

# Environment variables & Sensitive Credentials (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Node Dependencies
**/node_modules/
node_modules/

# Production & Build Outputs
**/dist/
**/build/
**/out/
dist/
build/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System & OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Temporary & Scratch Files
scratch/
tmp/
*.tmp
